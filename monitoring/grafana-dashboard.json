{
  "title": "MediDesk API Metrics",
  "panels": [
    {"title": "HTTP requests total", "targets": [{"expr": "sum by (method, handler) (http_requests_total)"}]},
    {"title": "Request latency p95", "targets": [{"expr": "histogram_quantile(0.95, sum by (le, handler) (rate(http_request_duration_seconds_bucket[5m])))"}]},
    {"title": "Error rate", "targets": [{"expr": "sum(rate(http_requests_total{status=~\"5..\"}[5m]))"}]}
  ]
}
